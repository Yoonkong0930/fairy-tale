FORM LUC_SAVE_0100 .
  CLEAR :GT_CELLTAB.
  " ## ## ###
  CHECK GO_COMFUNC->CHECK_MESSAGE( IV_MSG = 'S' ) = 'X'.

  IF GT_S0100_DEL IS NOT INITIAL.
    SELECT * FROM SPFLI AS A INNER JOIN @GT_S0100_DEL AS B
      ON A~CARRID = B~CARRID AND A~CONNID = B~CONNID
      INTO TABLE @DATA(LT_SPFLI_DEL).

    IF LT_SPFLI_DEL[] IS NOT INITIAL.
      DELETE SPFLI FROM TABLE  @LT_SPFLI_DEL.
    ENDIF.
  ENDIF.

  DELETE GT_S0100_TEMP WHERE ICON = ICON_GREEN_LIGHT.

  DATA(LT_SPFLI) = CORRESPONDING TYT_SPFLIX( GT_S0100_TEMP ).

*  DATA(LS_SPFLI) = VALUE TYPE# ##( RUSER  = SY-UNAME
*                                      RDATE  = SY-DATUM
*                                      RTIME  = SY-UZEIT ).

*  MODIFY LT_SPFLI FROM LS_SPFLI
*         TRANSPORTING RUSER RDATE RTIME
*         WHERE ICON = ICON_YELLOW_LIGHT.


  IF LT_SPFLI IS NOT INITIAL.
    MODIFY SPFLI FROM TABLE LT_SPFLI.
  ENDIF.


  COMMIT WORK AND WAIT.

  DATA(LS_S0100) = VALUE TYS_S0100( ICON = ICON_GREEN_LIGHT
                                    MESSAGE = SPACE
                                    CELLTAB = GT_CELLTAB ).
  MODIFY GT_S0100 FROM LS_S0100
         TRANSPORTING ICON MESSAGE CELLTAB
         WHERE ICON = ICON_YELLOW_LIGHT.

  MESSAGE S001 WITH TEXT-S01.  " & ### ## #####.

  CLEAR : GT_S0100_TEMP,GV_SAVE_FLAG_0100.
  GT_S0100_TEMP[] = GT_S0100[].

ENDFORM.
