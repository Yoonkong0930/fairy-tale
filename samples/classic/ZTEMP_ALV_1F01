FORM SET_ALV_TOOLMENU_0100 USING  PV_DYNNR    TYPE SY-DYNNR
                                  EV_OBJECT TYPE REF TO  CL_CTMENU
                                  PV_UCOMM LIKE SY-UCOMM.

  DATA: LT_DROP  TYPE LVC_T_DRAL,
        LV_FCODE TYPE SY-UCOMM,
        LV_TEXT  TYPE  TEXT40.

*#--List ##
  APPEND VALUE #( HANDLE = SPACE VALUE = 'Choice 1' INT_VALUE = 'A' ) TO LT_DROP.
  APPEND VALUE #( HANDLE = SPACE VALUE = 'Choice 2' INT_VALUE = 'B' ) TO LT_DROP.
  APPEND VALUE #( HANDLE = SPACE VALUE = 'Choice 3' INT_VALUE = 'C' ) TO LT_DROP.

*#--List ##
  CASE PV_UCOMM.
    WHEN 'BTN_LIST'.

      LOOP AT LT_DROP INTO DATA(LS_DROP).
        CLEAR: LV_TEXT, LV_FCODE.
        IF LS_DROP-INT_VALUE IS NOT INITIAL.
          LV_TEXT  = LS_DROP-VALUE.     " ##### text
          LV_FCODE = LS_DROP-INT_VALUE.   "#### sy-ucomm# ## #
        ELSE.
*          lv_text  = gc_text.
*          lv_fcode = gc_drop_cmd-000.    "#Enter## user command ## ##
        ENDIF.

        CALL METHOD EV_OBJECT->ADD_FUNCTION
          EXPORTING
            FCODE = LV_FCODE
            TEXT  = LV_TEXT.
      ENDLOOP.
  ENDCASE.
ENDFORM.
