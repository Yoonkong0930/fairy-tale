  DATA : LS_DROPDOWN  TYPE LVC_S_DRAL.

  SELECT DISTINCT CARRID AS  INT_VALUE
                  CARRNAME AS VALUE
     FROM SCARR
  INTO CORRESPONDING FIELDS OF TABLE GT_DROPDOWN.

  LS_DROPDOWN-HANDLE     = '100001'.
  MODIFY GT_DROPDOWN FROM LS_DROPDOWN
         TRANSPORTING HANDLE
         WHERE HANDLE = 0.


  DATA: LV_HANDLE     TYPE INT4,
        LV_COUNTRY    TYPE SCITAIRP-COUNTRY,
        LV_AIRPORT    TYPE SCITAIRP-AIRPORT,
        LV_MASTERCITY TYPE SCITAIRP-MASTERCITY.

  SELECT DISTINCT COUNTRY
       FROM SCITAIRP
       INTO LV_COUNTRY.

    FIND FIRST OCCURRENCE OF LV_COUNTRY+0(1) IN SY-ABCDE
        IN CHARACTER MODE MATCH OFFSET DATA(LV_OFFSET1).

    FIND FIRST OCCURRENCE OF LV_COUNTRY+1(2) IN SY-ABCDE
       IN CHARACTER MODE MATCH OFFSET DATA(LV_OFFSET2).

    DATA(LV_OFFSET) = LV_OFFSET1 && LV_OFFSET2.

    CHECK SY-SUBRC = 0.

    LV_HANDLE = 100100 + LV_OFFSET.

    SELECT DISTINCT AIRPORT
          FROM SCITAIRP
          WHERE COUNTRY = @LV_COUNTRY
          INTO @LV_AIRPORT .

      READ TABLE GT_DROPDOWN WITH KEY HANDLE     = LV_HANDLE
                                      INT_VALUE  = LV_AIRPORT
           TRANSPORTING NO FIELDS.
      IF SY-SUBRC NE 0.
        APPEND VALUE #( HANDLE    = LV_HANDLE
                        INT_VALUE = LV_AIRPORT
                        VALUE     =  LV_AIRPORT ) TO GT_DROPDOWN.
      ENDIF.
    ENDSELECT .
  ENDSELECT.


  SORT GT_DROPDOWN BY HANDLE VALUE.

