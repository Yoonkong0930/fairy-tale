FORM ALV_DELETE_ROW .

  DATA : LT_ROWS TYPE LVC_T_ROW.
*          ls_rows TYPE lvc_s_row.
*

  " ## ## ###
  CHECK GO_COMFUNC->CHECK_MESSAGE( IV_MSG = 'D1' ) = 'X'.

  CALL METHOD GO_GRID_0100->GET_SELECTED_ROWS
    IMPORTING
      ET_INDEX_ROWS = LT_ROWS.
  "alv## ### ### it_rows# ####.
  DESCRIBE TABLE LT_ROWS LINES SY-TFILL.

  IF SY-TFILL = 0.
    MESSAGE I000 WITH '### #####'.
    EXIT.
  ELSE.
    LOOP AT LT_ROWS INTO DATA(LS_ROWS).
      READ TABLE GT_S0100 INTO DATA(LS_S0100)
                       INDEX LS_ROWS-INDEX.
      IF SY-SUBRC = 0.
        LS_S0100-CRUD = 'D'.
        MODIFY GT_S0100 FROM LS_S0100 INDEX LS_ROWS-INDEX
              TRANSPORTING CRUD.
* #### DB #### ###
        IF LS_S0100-ICON = ICON_GREEN_LIGHT.
          READ TABLE GT_S0100_DEL INTO DATA(LS_S0100_DEL)
                           WITH KEY CARRID = LS_S0100-CARRID
                                    CONNID = LS_S0100-CONNID .
          IF SY-SUBRC NE 0.
            GT_S0100_DEL = VALUE #( ( CARRID = LS_S0100-CARRID
                         CONNID = LS_S0100-CONNID ) ).

          ENDIF.

        ENDIF.

      ENDIF.

      READ TABLE GT_S0100_TEMP INTO DATA(LS_S0100_TEMP)
                       INDEX LS_ROWS-INDEX.
      IF SY-SUBRC = 0.
        LS_S0100_TEMP-CRUD = 'D'.
        MODIFY GT_S0100_TEMP FROM LS_S0100_TEMP
                      INDEX LS_ROWS-INDEX
              TRANSPORTING CRUD.
      ENDIF.

    ENDLOOP.
  ENDIF.


  DELETE GT_S0100 WHERE CRUD = 'D'.
  DELETE GT_S0100_TEMP WHERE CRUD = 'D'.


  " ### ## ## #### ####
  IF LINE_EXISTS( GT_S0100[ ICON = ICON_RED_LIGHT ] ).
    GV_ACTION_FLAG_0100 = 'D'.
  ELSE.
    GV_ACTION_FLAG_0100 = 'A'.
  ENDIF.

* PAI ## ## ##(USER_COMMOND) PBO#
*#### #### ##
  CALL METHOD CL_GUI_CFW=>SET_NEW_OK_CODE
    EXPORTING
      NEW_CODE = 'ENTER'.


ENDFORM.
