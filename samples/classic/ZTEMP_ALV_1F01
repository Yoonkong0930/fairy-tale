*        CELLTAB   TYPE LVC_T_STYL,      " CHANGE THE PROPERTIES OF A FIELD
*        CELLCOLOR TYPE LVC_T_SCOL,      " CTAB_FNAME [ LVC_T_SCOL ]
*      END OF TYS_MOD_TAB .

  PT_MOD_TAB = VALUE #( ( UPT_TAB = 'X'
                          INDEX =  PS_MODI_CELL-ROW_ID
                           CELLTAB = PS_WORK-CELLTAB ) ).

  MODIFY GT_S0100 FROM PS_WORK INDEX PS_MODI_CELL-ROW_ID
         TRANSPORTING COUNTRYFR_TXT AIRPFROM_HDL
                      ICON ENUMBER  MESSAGE.


