*&---------------------------------------------------------------------*
*& Form GET_DATA
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
FORM GET_DATA .

  CLEAR : GT_SAIRPORT , GT_S0100, GT_T005T.
  IF P_CARRID IS NOT INITIAL.
    DATA(CARRID_RANGE) = VALUE CARRID_RANGE(
     ( SIGN = 'I' OPTION = 'EQ' LOW = P_CARRID HIGH = ' ') ).
  ENDIF.


  IF P_CONTFR IS NOT INITIAL.
    SET_RANGES : R_COUNTRYFR 'I' 'EQ' P_CONTFR ' '.
  ENDIF.

  SELECT CARRID,   "#####
         CONNID,   "### ## ##
         COUNTRYFR ,"##/## #
         CITYFROM  ,"## ##
         AIRPFROM  ,"## ##
         COUNTRYTO ,"##/## #
         CITYTO    ,"## ##
         AIRPTO    ,"## ##
         FLTIME    ,"## ##
         DEPTIME   ,"####
         ARRTIME   ,"####
         DISTANCE  ,"##
         DISTID    ,"#### (kms, miles)
         FLTYPE    ,"### ##
         PERIOD     "n# # ##
  FROM SPFLI
  WHERE CARRID IN @CARRID_RANGE
    AND CONNID IN @S_CONNID
    AND COUNTRYFR IN @R_COUNTRYFR
    AND AIRPFROM IN @S_AIRPFR
      INTO CORRESPONDING FIELDS OF TABLE @GT_S0100.

  IF GT_S0100 IS INITIAL.
    MESSAGE S000 WITH TEXT-E01.
    LEAVE LIST-PROCESSING.
  ENDIF.

  SELECT *
   FROM SAIRPORT CLIENT SPECIFIED
   WHERE MANDT = @SY-MANDT
   INTO CORRESPONDING FIELDS OF TABLE @GT_SAIRPORT.

  SELECT *
   FROM T005T
   WHERE SPRAS = @SY-LANGU
   INTO CORRESPONDING FIELDS OF TABLE @GT_T005T.

ENDFORM.
*&---------------------------------------------------------------------*
*& Form CREATE_DISPLAY_DATA
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
FORM CREATE_DISPLAY_DATA .

* ITAB# DB JOIN ## ##
* Local itab select### ##
  SELECT A~CARRID, "### ##
         A~CARRNAME, "#####
         A~URL       "### URL
  FROM SCARR AS A INNER JOIN
        @GT_S0100 AS B
       ON A~CARRID = B~CARRID
  INTO TABLE @DATA(LT_SCARR).

  DELETE ADJACENT DUPLICATES FROM LT_SCARR.


  LOOP AT GT_S0100 INTO DATA(LS_S0100).

    DATA(LV_IDX) = SY-TABIX.

    READ TABLE GT_T005T INTO DATA(LS_T005T)
                      WITH KEY LAND1 = LS_S0100-COUNTRYFR.
    IF SY-SUBRC = 0.
      LS_S0100-COUNTRYFR_TXT = LS_T005T-LANDX50.
    ENDIF.

    READ TABLE GT_T005T INTO DATA(LS_T005T1)
                      WITH KEY LAND1 = LS_S0100-COUNTRYTO.
    IF SY-SUBRC = 0.
      LS_S0100-COUNTRYTO_TXT = LS_T005T1-LANDX50.
    ENDIF.


*READ TABLE # ## ##
*FIELD ### #### ##

*#### #
    TRY.
        DATA(LS_SAIRPORT) = GT_SAIRPORT[ ID = LS_S0100-AIRPFROM ].
      CATCH CX_SY_ITAB_LINE_NOT_FOUND .
        CLEAR LS_SAIRPORT.
    ENDTRY.

    IF LS_SAIRPORT IS NOT INITIAL.
      LS_S0100-AIRPFROM_TXT = LS_SAIRPORT-NAME.
    ENDIF.

*#### #
    TRY.
        LS_SAIRPORT = GT_SAIRPORT[ ID = LS_S0100-AIRPTO ].
      CATCH CX_SY_ITAB_LINE_NOT_FOUND .
        CLEAR LS_SAIRPORT.
    ENDTRY.

    IF LS_SAIRPORT IS NOT INITIAL.
      LS_S0100-AIRPTO_TXT = LS_SAIRPORT-NAME.
    ENDIF.


*#####
* LS_SCARR# ## ##  FIELD ### #### LS_S0100#
* ## BASE# ## ## ###.
* ### CARRNAME # ## #### ## ###~
    TRY.
        DATA(LS_SCARR) = LT_SCARR[ CARRID = LS_S0100-CARRID ].
      CATCH CX_SY_ITAB_LINE_NOT_FOUND . "<= ST22## ### ##### Except## ##
        CLEAR LS_SCARR.
    ENDTRY.

    IF LS_SCARR IS NOT INITIAL.
* LS_SCARR# ## FIELD## LS_S0100 ##### #### #### ###
*# ## ##  ####,
      LS_S0100 = CORRESPONDING #( BASE ( LS_S0100 )  LS_SCARR ).
*      LS_S0100-CARRNAME = LS_SCARR-CARRNAME.
    ENDIF.

* #### HANDLE
    FIND FIRST OCCURRENCE OF LS_S0100-COUNTRYFR+0(1) IN SY-ABCDE
        IN CHARACTER MODE MATCH OFFSET DATA(LV_OFFSET1).

    FIND FIRST OCCURRENCE OF LS_S0100-COUNTRYFR+1(2) IN SY-ABCDE
       IN CHARACTER MODE MATCH OFFSET DATA(LV_OFFSET2).

    DATA(LV_OFFSET) = LV_OFFSET1 && LV_OFFSET2.

    LS_S0100-AIRPFROM_HDL =  100100 + LV_OFFSET.


* #### HANDLE
    CLEAR : LV_OFFSET1 , LV_OFFSET2, LV_OFFSET.

    FIND FIRST OCCURRENCE OF LS_S0100-COUNTRYTO+0(1) IN SY-ABCDE
        IN CHARACTER MODE MATCH OFFSET LV_OFFSET1.

    FIND FIRST OCCURRENCE OF LS_S0100-COUNTRYTO+1(2) IN SY-ABCDE
       IN CHARACTER MODE MATCH OFFSET LV_OFFSET2.

    LV_OFFSET = LV_OFFSET1 && LV_OFFSET2.

    LS_S0100-AIRPTO_HDL =  100100 + LV_OFFSET.
* icon_yellow_light.  icon_red_light.
    LS_S0100-ICON =  ICON_GREEN_LIGHT.

    IF LS_S0100-FLTYPE IS NOT INITIAL.
*field ##
      GO_ALV_INFO->INSERT_CELLCOLOR( EXPORTING IV_FIELDNAME = 'FLTYPE'
                                               IV_COLOR     = '6'
                                     CHANGING  CT_CELLCOLOR = LS_S0100-CELLCOLOR ).
    ENDIF.

    LS_S0100-CRUD = 'R'.

    LS_S0100-BUTTON =   ICON_ENTER_MORE.
    MODIFY GT_S0100 FROM LS_S0100 INDEX LV_IDX
              TRANSPORTING  CARRNAME AIRPFROM_TXT  AIRPTO_TXT
                            AIRPFROM_HDL  AIRPTO_HDL COUNTRYFR_TXT
                            COUNTRYTO_TXT URL cellcolor BUTTON ICON CRUD .

  ENDLOOP.

  GT_S0100_TEMP[] = GT_S0100[].
  GV_DBCNT = LINES( GT_S0100 ).
  MESSAGE S010 WITH GV_DBCNT.   " & ## ## #####.


ENDFORM.

