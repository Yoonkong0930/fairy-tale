  DATA : LT_EDIT TYPE LVC_T_STYL.
  CLEAR :  PS_WORK-COUNTRYFR_TXT.
  SELECT SINGLE LANDX50 INTO  PS_WORK-COUNTRYFR_TXT
      FROM T005T
      WHERE SPRAS = SY-LANGU
       AND LAND1 = PS_MODI_CELL-VALUE.

  IF PS_WORK-COUNTRYFR_TXT IS INITIAL.
    PS_WORK-ICON = ICON_RED_LIGHT.
    PS_WORK-MESSAGE = '## ### ###.'.
    PS_WORK-ENUMBER = 1.
  ELSE.
    IF PS_WORK-ENUMBER = 1.
      PS_WORK-ICON = ICON_YELLOW_LIGHT.
      CLEAR : PS_WORK-MESSAGE ,PS_WORK-ENUMBER.
    ENDIF.
  ENDIF.


  FIND FIRST OCCURRENCE OF PS_MODI_CELL-VALUE+0(1) IN SY-ABCDE
      IN CHARACTER MODE MATCH OFFSET DATA(LV_OFFSET1).

  FIND FIRST OCCURRENCE OF PS_MODI_CELL-VALUE+1(2) IN SY-ABCDE
     IN CHARACTER MODE MATCH OFFSET DATA(LV_OFFSET2).

  DATA(LV_OFFSET) = LV_OFFSET1 && LV_OFFSET2.

  PS_WORK-AIRPFROM_HDL =  100100 + LV_OFFSET.

*  LT_EDIT = PS_WORK-CELLTAB.

  %COM_ALV_SET_CELLTAB PS_WORK-CELLTAB  'E' 'AIRPFROM'.

* CELLTAB# CELLCOLOR# ##### PT_MOD_TAB# #####.
